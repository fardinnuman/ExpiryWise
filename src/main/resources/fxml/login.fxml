<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.expirywise.controller.LoginController"
      alignment="CENTER"
      spacing="0"
      prefWidth="480"
      prefHeight="620"
      styleClass="login-root">

    <padding>
        <Insets top="20" right="24" bottom="20" left="24"/>
    </padding>

    <VBox spacing="16"
          alignment="CENTER"
          maxWidth="400"
          styleClass="login-card">

        <padding>
            <Insets top="28" right="28" bottom="28" left="28"/>
        </padding>

        <VBox alignment="CENTER" spacing="6">
            <HBox alignment="CENTER" spacing="8">
                <Label text="🌿" styleClass="brand-icon"/>
                <Label text="ExpiryWise" styleClass="login-title"/>
            </HBox>
            <Label fx:id="subtitleLabel"
                   text="Smart Food Expiry &amp; Inventory Management"
                   styleClass="login-subtitle"
                   wrapText="true"
                   textAlignment="CENTER"/>
        </VBox>

        <Label fx:id="errorLabel"
               text=""
               visible="false"
               managed="false"
               wrapText="true"
               styleClass="form-error-banner"/>

        <Label fx:id="successLabel"
               text=""
               visible="false"
               managed="false"
               wrapText="true"
               styleClass="form-success-banner"/>

        <VBox spacing="12" maxWidth="Infinity">
            <VBox fx:id="nameFieldBox" spacing="5" visible="false" managed="false">
                <Label text="Full Name" styleClass="form-label"/>
                <TextField fx:id="nameField"
                           promptText="e.g. Alex Chef"
                           styleClass="form-field"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Email Address" styleClass="form-label"/>
                <TextField fx:id="emailField"
                           promptText="name@example.com"
                           styleClass="form-field"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Password" styleClass="form-label"/>
                <PasswordField fx:id="passwordField"
                               promptText="••••••••"
                               styleClass="form-field"/>
            </VBox>

            <VBox fx:id="confirmPasswordBox" spacing="5" visible="false" managed="false">
                <Label text="Confirm Password" styleClass="form-label"/>
                <PasswordField fx:id="confirmPasswordField"
                               promptText="••••••••"
                               styleClass="form-field"/>
            </VBox>
        </VBox>

        <VBox spacing="10" maxWidth="Infinity">
            <Button fx:id="actionButton"
                    text="Sign In"
                    onAction="#handlePrimaryAction"
                    maxWidth="Infinity"
                    styleClass="primary-button"/>

            <Button fx:id="demoButton"
                    text="Quick Demo Sign In →"
                    onAction="#handleDemoSignIn"
                    maxWidth="Infinity"
                    styleClass="secondary-button"/>

            <Button fx:id="toggleModeButton"
                    text="Don't have an account? Create one"
                    onAction="#handleToggleMode"
                    maxWidth="Infinity"
                    styleClass="link-button"/>
        </VBox>

        <Label text="Local database storage · Version 1.0"
               styleClass="login-footer-text"/>
    </VBox>

</VBox>