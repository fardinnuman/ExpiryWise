<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.expirywise.controller.MainController"
            prefWidth="1240"
            prefHeight="780">

    <left>
        <VBox prefWidth="255"
              styleClass="sidebar"
              spacing="6">

            <padding>
                <Insets top="24" right="16" bottom="20" left="16"/>
            </padding>

            <HBox alignment="CENTER_LEFT"
                  spacing="10"
                  styleClass="sidebar-brand-container">
                <Label text="🌿" styleClass="sidebar-logo-icon"/>
                <VBox spacing="1">
                    <Label text="ExpiryWise" styleClass="sidebar-logo-text"/>
                    <Label text="Pantry Management" styleClass="sidebar-logo-sub"/>
                </VBox>
            </HBox>

            <Separator styleClass="sidebar-separator"/>

            <Label text="NAVIGATION" styleClass="sidebar-section-title"/>

            <VBox spacing="4" styleClass="sidebar-navigation">

                <Button fx:id="btnDashboard"
                        text="  ⊞   Dashboard"
                        styleClass="sidebar-item"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#showDashboard"/>

                <Button fx:id="btnAnalytics"
                        text="  📊   Analytics"
                        styleClass="sidebar-item"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#showAnalytics"/>

                <Button fx:id="btnCalendar"
                        text="  📅   Calendar"
                        styleClass="sidebar-item"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#showCalendar"/>

                <Button fx:id="btnShoppingList"
                        text="  🛒   Shopping List"
                        styleClass="sidebar-item"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#showShoppingList"/>

                <HBox alignment="CENTER_LEFT" spacing="0">
                    <Button fx:id="btnNotifications"
                            text="  🔔   Notifications"
                            styleClass="sidebar-item"
                            HBox.hgrow="ALWAYS"
                            maxWidth="Infinity"
                            alignment="CENTER_LEFT"
                            onAction="#showNotifications"/>
                    <Label fx:id="notificationBadge"
                           text="0"
                           visible="false"
                           managed="false"
                           styleClass="sidebar-badge"/>
                </HBox>

                <Button fx:id="btnSettings"
                        text="  ⚙️   Settings"
                        styleClass="sidebar-item"
                        maxWidth="Infinity"
                        alignment="CENTER_LEFT"
                        onAction="#showSettings"/>

            </VBox>

            <VBox VBox.vgrow="ALWAYS"/>

            <VBox styleClass="sidebar-user-card" spacing="4">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="👤" styleClass="user-avatar-icon"/>
                    <VBox spacing="1">
                        <Label text="My Kitchen" styleClass="user-name-label"/>
                        <Label fx:id="sidebarPantryStats"
                               text="0 items tracked"
                               styleClass="user-status-label"/>
                    </VBox>
                </HBox>
            </VBox>

            <Button text="  🚪   Sign Out"
                    styleClass="sidebar-logout-btn"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#handleLogout"/>

        </VBox>
    </left>

    <center>
        <VBox fx:id="contentArea"
              styleClass="content-area"
              VBox.vgrow="ALWAYS"
              alignment="TOP_LEFT"/>
    </center>

</BorderPane>