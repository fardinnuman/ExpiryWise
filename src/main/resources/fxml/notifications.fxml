<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.expirywise.controller.NotificationsController"
      spacing="16"
      styleClass="notifications-view"
      VBox.vgrow="ALWAYS">

    <padding>
        <Insets top="20" right="24" bottom="20" left="24"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label text="Notifications &amp; Alerts" styleClass="content-title"/>
            <Label text="Stay informed about food nearing expiration to prevent waste and save money"
                   styleClass="content-subtitle"/>
        </VBox>

        <Label fx:id="alertCountBadge"
               text="0 Alerts"
               styleClass="notifications-count-badge"/>
    </HBox>

    <HBox spacing="8" alignment="CENTER_LEFT" styleClass="notifications-filter-bar">
        <Button fx:id="filterAllBtn" text="All Alerts" onAction="#handleFilterAll" styleClass="filter-tab, filter-tab-active"/>
        <Button fx:id="filterCriticalBtn" text="Critical (Expired &amp; Today)" onAction="#handleFilterCritical" styleClass="filter-tab"/>
        <Button fx:id="filterSoonBtn" text="Expiring Soon (1–3 Days)" onAction="#handleFilterSoon" styleClass="filter-tab"/>
    </HBox>

    <ScrollPane fitToWidth="true"
                fitToHeight="true"
                VBox.vgrow="ALWAYS"
                styleClass="notifications-scroll">

        <StackPane alignment="TOP_CENTER" VBox.vgrow="ALWAYS">
            <VBox fx:id="notificationsContainer"
                  spacing="10"
                  styleClass="notifications-list">
                <padding>
                    <Insets top="4" right="4" bottom="16" left="4"/>
                </padding>
            </VBox>

            <VBox fx:id="emptyStateContainer"
                  alignment="CENTER"
                  spacing="12"
                  visible="false"
                  managed="false"
                  styleClass="empty-state-container">
                <Label text="🎉" styleClass="empty-state-icon"/>
                <Label text="All Caught Up!" styleClass="empty-state-title"/>
                <Label text="None of your food items require immediate attention. Everything is fresh!"
                       styleClass="empty-state-subtitle"
                       textAlignment="CENTER"/>
            </VBox>
        </StackPane>

    </ScrollPane>

</VBox>