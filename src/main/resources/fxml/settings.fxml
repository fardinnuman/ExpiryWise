<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.expirywise.controller.SettingsController"
            fitToWidth="true"
            styleClass="settings-scroll">

    <VBox spacing="20" styleClass="settings-view">
        <padding>
            <Insets top="20" right="28" bottom="30" left="28"/>
        </padding>

        <VBox spacing="2">
            <Label text="Settings &amp; Preferences" styleClass="content-title"/>
            <Label text="Customize your workspace, alerts, themes, and manage local data"
                   styleClass="content-subtitle"/>
        </VBox>

        <VBox spacing="14" styleClass="settings-card">
            <Label text="Appearance" styleClass="section-title"/>

            <HBox spacing="16" alignment="CENTER_LEFT">
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label text="Dark Theme" styleClass="settings-label"/>
                    <Label text="Switch between light workspace and high-contrast dark mode"
                           styleClass="settings-description"/>
                </VBox>
                <CheckBox fx:id="darkModeCheckBox" text="Enable Dark Mode" styleClass="settings-toggle"/>
            </HBox>
        </VBox>

        <VBox spacing="14" styleClass="settings-card">
            <Label text="Notification Preferences" styleClass="section-title"/>

            <HBox spacing="16" alignment="CENTER_LEFT">
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label text="Expiring Soon Warning Window" styleClass="settings-label"/>
                    <Label text="Items within this window will trigger 'Use Soon' alerts and dashboard badges"
                           styleClass="settings-description"/>
                </VBox>
                <ComboBox fx:id="thresholdComboBox" prefWidth="180" styleClass="form-combo"/>
            </HBox>
        </VBox>

        <VBox spacing="14" styleClass="settings-card">
            <Label text="Data &amp; Backup" styleClass="section-title"/>

            <HBox spacing="16" alignment="CENTER_LEFT">
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label text="Export Inventory to CSV" styleClass="settings-label"/>
                    <Label text="Download your complete food inventory spreadsheet for backup or spreadsheet analysis"
                           styleClass="settings-description"/>
                </VBox>
                <Button text="Export to CSV" onAction="#handleExportCsv" styleClass="secondary-button"/>
            </HBox>

            <Separator styleClass="dialog-separator"/>

            <HBox spacing="16" alignment="CENTER_LEFT">
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label text="Load Demo Sample Pantry" styleClass="settings-label"/>
                    <Label text="Populates a variety of fresh, expiring, and expired groceries to easily test features"
                           styleClass="settings-description"/>
                </VBox>
                <Button text="Load Sample Data" onAction="#handleLoadSampleData" styleClass="secondary-button"/>
            </HBox>

            <Separator styleClass="dialog-separator"/>

            <HBox spacing="16" alignment="CENTER_LEFT">
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label text="Clear All Inventory Data" styleClass="settings-label"/>
                    <Label text="Permanently deletes all food items in your local SQLite database"
                           styleClass="settings-description"/>
                </VBox>
                <Button text="Delete All Data" onAction="#handleClearAllData" styleClass="btn-text-danger"/>
            </HBox>
        </VBox>

        <VBox spacing="12" styleClass="settings-card">
            <Label text="About ExpiryWise" styleClass="section-title"/>

            <HBox spacing="16" alignment="CENTER_LEFT">
                <Label text="🌿" styleClass="about-brand-icon"/>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="ExpiryWise — Desktop Food Freshness Assistant" styleClass="about-title"/>
                    <Label text="Version 1.0 Production Edition · Built with Java 21, JavaFX 21 &amp; SQLite"
                           styleClass="settings-description"/>
                    <Label text="Crafted to eliminate household grocery waste through intelligent expiry tracking."
                           styleClass="settings-description"/>
                </VBox>
            </HBox>
        </VBox>

    </VBox>
</ScrollPane>